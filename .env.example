# Starter settings; complete reference and runtime defaults: docs/running.md
DATA_DIR=./traefik-data
TZ=UTC
LETSENCRYPT_EMAIL=you@example.com
TRAEFIK_IMAGE=traefik:v3.7.17
PROJECT_NAME=traefik
PROXY_NETWORK=proxy

# Leave empty to disable the dashboard. Create credentials before deploying it.
DASHBOARD_HOSTNAME=
DASHBOARD_LOGIN=admin

# Example ports (runtime default is empty). Every port gets TCP and UDP.
# Use spaces or commas; 80, 443, 8080 and HTTP/HTTPS host ports are reserved.
CUSTOM_PORTS="51227 58526"
HTTP_PORT=80
HTTPS_PORT=443
BIND_ADDRESS=0.0.0.0

# Optional exporter. Its image is built locally with jq and OpenSSL.
CERTS_EXPORT=false

# Docker rotates stdout/stderr logs; no rotation sidecar or socket is needed.
LOG_LEVEL=WARN
LOG_ROTATE_MAX_BACKUPS=5
LOG_ROTATE_TRIGGER_SIZE=10m

# Use staging for issuance tests; switch back for publicly trusted certificates.
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
